{
  "id": "hello-remote",
  "name": "Hello Remote",
  "description": "Kitchen-sink example: service, port, host tool, skill, container commands, Go plugin, and every frontend extension slot.",
  "category": "development",
  "version": "7",
  "icon": "ui/assets/logo.svg",
  "scopes": ["global", "project"],
  "base": "ubuntu:24.04",
  "port": {
    "internal": 4780,
    "defaultExternal": 4780,
    "protocol": "tcp",
    "bindAddress": "127.0.0.1"
  },
  "env": [
    {
      "key": "HELLO_GREETING",
      "label": "Greeting",
      "default": "Hello"
    },
    {
      "key": "HELLO_USER",
      "label": "Connection user",
      "required": true,
      "default": "remote"
    },
    {
      "key": "HELLO_PASSWORD",
      "label": "Service password",
      "required": true,
      "secret": true,
      "generate": "password"
    },
    {
      "key": "HELLO_DATABASE",
      "label": "Example database",
      "default": "hello"
    }
  ],
  "service": "hello-remote",
  "connection": {
    "user": "hello",
    "userEnv": "HELLO_USER",
    "passwordEnv": "HELLO_PASSWORD",
    "databaseEnv": "HELLO_DATABASE"
  },
  "install": "infra/install.sh",
  "healthcheck": {
    "command": "/usr/local/bin/hello-remote-service health --port {{internalPort}}"
  },
  "hostTools": [
    {
      "name": "restic",
      "version": "0.18.0",
      "downloads": {
        "amd64": {
          "url": "https://github.com/restic/restic/releases/download/v0.18.0/restic_0.18.0_linux_amd64.bz2",
          "sha256": "98f6dd8bf5b59058d04bfd8dab58e196cc2a680666ccee90275a3b722374438e",
          "compression": "bzip2"
        },
        "arm64": {
          "url": "https://github.com/restic/restic/releases/download/v0.18.0/restic_0.18.0_linux_arm64.bz2",
          "sha256": "ce18179c25dc5f2e33e3c233ba1e580f9de1a4566d2977e8d9600210363ec209",
          "compression": "bzip2"
        }
      },
      "versionArgs": ["version"]
    }
  ],
  "ui": {
    "entry": "scripts/main.js",
    "styles": ["style/hello.css"],
    "views": {
      "panel": "views/panel.html"
    }
  },
  "backend": {
    "access": "registered",
    "timeoutMs": 10000
  }
}
